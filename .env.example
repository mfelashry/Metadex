# Browser origin of the Metadex site. The forensic API reads this on the server.
# Leave METADEX_CORS_ORIGINS unset for local development (localhost and 127.0.0.1).
# METADEX_CORS_ORIGINS=http://127.0.0.1:5173

# Where the website calls the forensic API. Restart `npm run dev` after changing it.
VITE_STILLFRAME_API=http://127.0.0.1:8741

# Case files, previews, and embeddings. Deleted on DELETE or when the clock runs out.
# METADEX_CASE_DIR=
# METADEX_CASE_TTL_SECONDS=21600
# METADEX_CASE_MAX_TOTAL_BYTES=104857600
# METADEX_MAX_CASES=30

# OpenCLIP. The first load downloads weights into the cache. Searches after that stay local.
# METADEX_CLIP_MODEL=ViT-B-32
# METADEX_CLIP_PRETRAINED=openai
# METADEX_CLIP_CACHE=
# auto uses CUDA when PyTorch can see a GPU, otherwise CPU. cpu and cuda are explicit.
# METADEX_DEVICE=auto
# METADEX_PRELOAD_MODEL=0

# Local `metadex serve` turns this on because it binds to 127.0.0.1 only.
# Leave it unset on any public host, including Vultr.
# STILLFRAME_ALLOW_FOLDER_SCAN=0

# Optional. Used only by the explain endpoint. Never required for image search.
# GEMINI_API_KEY=
